{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "groupName": "Go"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "extractVersion": "^(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "enabled": true
    }
  ]
}
